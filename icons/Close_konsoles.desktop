[Desktop Entry]
Comment[en_US]=
Comment=
Exec[$e]=$HOME/sfrs-mncl/scripts/konsole_manager.py --nodes x86l-170,x86l-132,x86l-253,x86l-260,x86l-261 --screens epx,ioc,com,web,mbs --close
GenericName[en_US]=
GenericName=
Icon[$e]=$HOME/sfrs-mncl/icons/close_konsoles.png
MimeType=
Name[en_US]=Close konsoles
Name=Close konsoles
Path[$e]=$HOME/sfrs-mncl
StartupNotify=true
Terminal=false
TerminalOptions=
Type=Application
X-KDE-SubstituteUID=false
X-KDE-Username=
